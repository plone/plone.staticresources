graft src/plone
graft docs
include *.rst
global-exclude *.pyc
include pyproject.toml
include resource-versions.json
recursive-exclude news *
exclude news
exclude .coveragerc
# exclude npmjs resources
exclude package.json
exclude .prettierrc.json
exclude Makefile
prune scripts
exclude babel.config.js
exclude webpack.config.js
exclude pnpm-lock.yaml
exclude pnpm-workspace.yaml
exclude .npmrc
